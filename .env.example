# Copia este archivo a `.env.local` y rellena los valores.
#
# `.env.local` NO se versiona (está en .gitignore). Este archivo sí, para documentar
# qué variables existen.

# Clave de la API de YouTube Data v3.
# Solo la usa el importador de catálogo, que corre en el servidor.
# Nunca lleva el prefijo NEXT_PUBLIC_: eso la expondría al navegador.
#
# Cómo obtenerla: https://console.cloud.google.com
#   → APIs y servicios → Biblioteca → "YouTube Data API v3" → Habilitar
#   → Credenciales → Crear credenciales → Clave de API
#   → Restringir la clave a "YouTube Data API v3"
YOUTUBE_API_KEY=

# Base de datos en la nube (Turso / libSQL) — opcional.
# Si no se definen, la aplicación usa SQLite local en `data/karaoke.db`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# URL pública para construir los enlaces del QR — opcional.
# En local se detecta automáticamente la IP LAN (ej. http://192.168.1.x:3000).
# En producción (Vercel), pon aquí el dominio público.
APP_URL=

# Autenticación de bares: generar una clave aleatoria de al menos 32 caracteres.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Servicio de correo transaccional y remitente de dominio verificado.
RESEND_API_KEY=
KARYOU_EMAIL_FROM='Karyou <cuentas@example.com>'
